#!/bin/bash
# ----------------------------------------------------------------------------
# hvigor wrapper for the OpenHarmony 6.1.1-LTS (API 23) project.
# The hvigor engine is pinned in package.json and installed into ./node_modules
# (the old hvigor-wrapper.js only understands hvigorVersion 2.x and cannot run
#  this project's modelVersion 6.0.0 configuration).
#
#   npm install
#   ./hvigorw assembleHap --mode module -p product=default --no-daemon
#
# 'java' (JDK 8+/17) must be available for the PackageHap task.
# ----------------------------------------------------------------------------
HVIGOR_APP_HOME=$(cd "$(dirname "$0")" && pwd)
HVIGOR_JS="${HVIGOR_APP_HOME}/node_modules/@ohos/hvigor/bin/hvigor.js"

if [ -n "${NODE_HOME}" ] && [ -x "${NODE_HOME}/bin/node" ]; then
	EXECUTABLE_NODE="${NODE_HOME}/bin/node"
else
	EXECUTABLE_NODE="node"
fi

if ! command -v "${EXECUTABLE_NODE}" > /dev/null 2>&1; then
	echo "ERROR: 'node' not found. Install Node.js >= 24.14.1 or set NODE_HOME." >&2
	exit 1
fi

if [ ! -f "${HVIGOR_JS}" ]; then
	echo "ERROR: hvigor is not installed (${HVIGOR_JS} missing)." >&2
	echo "Run 'npm install' in ${HVIGOR_APP_HOME} first (see README.md)." >&2
	exit 1
fi

exec "${EXECUTABLE_NODE}" "${HVIGOR_JS}" "$@"
